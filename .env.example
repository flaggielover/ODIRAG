# ODIRAG local development environment.
# Copy this file to .env for Compose, then replace every value marked for change.
# Never commit the resulting .env file or use these development values in production.

COMPOSE_PROJECT_NAME=odirag
ODIRAG_IMAGE_TAG=local

# Application
ODIRAG_APP_NAME=ODIRAG API
ODIRAG_ENVIRONMENT=development
ODIRAG_DEBUG=false
ODIRAG_API_PREFIX=/api
ODIRAG_LOG_LEVEL=INFO
ODIRAG_LOG_JSON=false
ODIRAG_DEPENDENCY_TIMEOUT_SECONDS=2
ODIRAG_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080","http://127.0.0.1:5173","http://127.0.0.1:8080"]
ODIRAG_AUTO_CREATE_SCHEMA=false

# PostgreSQL (development defaults only)
POSTGRES_DB=odirag
POSTGRES_USER=odirag
POSTGRES_PASSWORD=odirag_dev_password
POSTGRES_PORT=5432
ODIRAG_DATABASE_URL=postgresql+asyncpg://odirag:odirag_dev_password@postgres:5432/odirag
# Host-run override: postgresql+asyncpg://odirag:odirag_dev_password@localhost:5432/odirag
ODIRAG_DATABASE_ECHO=false
ODIRAG_DATABASE_POOL_SIZE=10
ODIRAG_DATABASE_MAX_OVERFLOW=20

# Redis and Qdrant
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
ODIRAG_REDIS_URL=redis://redis:6379/0
ODIRAG_QDRANT_URL=http://qdrant:6333
ODIRAG_QDRANT_API_KEY=
ODIRAG_HEALTH_CHECK_QDRANT=true
# Rate limits use shared Redis counters; only test fixtures should select memory.
ODIRAG_RATE_LIMIT_BACKEND=redis
# Accept X-Forwarded-For only from explicit reverse-proxy IPs/CIDRs. JSON arrays and
# comma-separated values are supported; whitespace is trimmed. Compose deliberately
# keeps the historical CSV form below as a compatibility example. Leave empty for a
# directly exposed ASGI server. Invalid entries prevent backend startup.
ODIRAG_TRUSTED_PROXY_IPS=172.30.0.10
ODIRAG_NGINX_PROXY_IP=172.30.0.10
ODIRAG_COMPOSE_NETWORK_SUBNET=172.30.0.0/24
# Host-run overrides: redis://localhost:6379/0 and http://localhost:6333

# Authentication. Use a random value with at least 32 characters outside development.
ODIRAG_JWT_SECRET_KEY=change-me-development-only-signing-key-32-chars
ODIRAG_JWT_ALGORITHM=HS256
ODIRAG_ACCESS_TOKEN_EXPIRE_MINUTES=30
ODIRAG_REFRESH_TOKEN_EXPIRE_DAYS=7
ODIRAG_ADMIN_USERNAME=admin
ODIRAG_ADMIN_PASSWORD=development-only-admin-password
ODIRAG_BOOTSTRAP_ADMIN=true
# ODIRAG_ADMIN_PASSWORD_HASH=replace-with-a-passlib-pbkdf2-sha256-hash-for-production

# Optional async task runtime. Enabled by the async Compose profile after task modules are available.
ODIRAG_CELERY_BROKER_URL=redis://redis:6379/1
ODIRAG_CELERY_RESULT_BACKEND=redis://redis:6379/2

# Autonomous source discovery. The key is optional until a live run is requested.
ODIRAG_SOURCE_DISCOVERY_PROVIDER=brave
ODIRAG_SOURCE_DISCOVERY_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
ODIRAG_SOURCE_DISCOVERY_API_KEY=
ODIRAG_SOURCE_DISCOVERY_TIMEOUT_SECONDS=20
ODIRAG_SOURCE_DISCOVERY_MAX_CANDIDATES=10
ODIRAG_SOURCE_DISCOVERY_MAX_COLUMNS=12
ODIRAG_SOURCE_DISCOVERY_TRIAL_MAX_DOCUMENTS=5
ODIRAG_SOURCE_DISCOVERY_TRIAL_MIN_CHARS=160
ODIRAG_SOURCE_DISCOVERY_QUALITY_THRESHOLD=0.65
ODIRAG_SOURCE_DISCOVERY_OFFICIAL_SUFFIXES=[".gov.cn",".gov",".edu.cn"]
# Optional unattended gap scans. Keep disabled until a real Brave key and an
# approved topic list are configured. JSON arrays and comma-separated topics are
# accepted; every discovered candidate still stops at manual approval.
ODIRAG_SOURCE_DISCOVERY_AUTO_ENABLED=false
ODIRAG_SOURCE_DISCOVERY_AUTO_TOPICS=[]
ODIRAG_SOURCE_DISCOVERY_AUTO_INTERVAL_SECONDS=3600
ODIRAG_SOURCE_DISCOVERY_AUTO_REGION=
ODIRAG_SOURCE_DISCOVERY_AUTO_ORGANIZATION_LEVEL=
ODIRAG_SOURCE_DISCOVERY_AUTO_REQUIRED_SOURCE_COUNT=1
ODIRAG_SOURCE_DISCOVERY_AUTO_REQUIRED_DOCUMENT_COUNT=3

# Provider objects start without credentials and report unavailable when called.
ODIRAG_LLM_PROVIDER=direct
ODIRAG_DIRECT_LLM_BASE_URL=https://api.openai.com/v1
ODIRAG_DIRECT_LLM_API_KEY=
ODIRAG_DIRECT_LLM_MODEL=gpt-4.1-mini
ODIRAG_COZE_BASE_URL=https://api.coze.com
ODIRAG_COZE_BOT_ID=
# Synchronous Coze crawl deployments. Keep the legacy and batch URLs separate.
# Leave both deployment URLs and the token blank until they are configured locally.
# The unprefixed names below are the canonical deployment variables; ODIRAG_ aliases
# remain supported by the backend for existing installations.
COZE_ENABLED=false
COZE_LEGACY_API_URL=
COZE_BATCH_API_URL=
COZE_API_TOKEN=
COZE_DEFAULT_CONTRACT=batch_crawl
COZE_TIMEOUT_SECONDS=90
COZE_MAX_RETRIES=2
ODIRAG_REVIEW_FILTER_CONFIG_PATH=../config/filters.yaml
ODIRAG_REVIEW_PROMPT_PATH=../config/prompts/document_review_v1.txt
ODIRAG_REVIEW_PROMPT_NAME=document_review
ODIRAG_REVIEW_PROMPT_VERSION=v1
ODIRAG_ANSWER_PROVIDER=extractive
ODIRAG_GROUNDED_ANSWER_PROMPT_PATH=../config/prompts/grounded_answer_v1.txt
ODIRAG_GROUNDED_ANSWER_PROMPT_VERSION=v1
ODIRAG_GROUNDING_MINIMUM_HITS=1
ODIRAG_GROUNDING_MINIMUM_SCORE=0
ODIRAG_GROUNDING_REQUIRE_OFFICIAL_SOURCE=true
ODIRAG_GROUNDING_REFUSE_ON_CONFLICT=true

ODIRAG_CHUNKING_CONFIG_PATH=../config/chunking.yaml
ODIRAG_EMBEDDING_PROVIDER=remote
ODIRAG_EMBEDDING_CACHE_PROVIDER=redis
ODIRAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
ODIRAG_EMBEDDING_API_KEY=
ODIRAG_EMBEDDING_MODEL=text-embedding-3-small
ODIRAG_EMBEDDING_DIMENSIONS=1536
ODIRAG_EMBEDDING_BATCH_SIZE=32
ODIRAG_EMBEDDING_VERSION=v1
ODIRAG_EMBEDDING_MINIMUM_INTERVAL_SECONDS=0
ODIRAG_EMBEDDING_CACHE_TTL_SECONDS=2592000
ODIRAG_EMBEDDING_COST_PER_1K_CHARS=0
ODIRAG_QDRANT_COLLECTION=odirag_chunks
ODIRAG_VECTOR_STORE_PROVIDER=qdrant
ODIRAG_BM25_SNAPSHOT_PATH=../data/indexes/bm25.json
ODIRAG_EVALUATION_ARTIFACT_DIR=../data/evaluation/runs
ODIRAG_EXPERIMENT_ARTIFACT_DIR=../data/experiments/runs
ODIRAG_RERANK_PROVIDER=none
ODIRAG_RERANK_BASE_URL=https://api.cohere.com/v2
ODIRAG_RERANK_API_KEY=
ODIRAG_RERANK_MODEL=rerank-v3.5
ODIRAG_RETRIEVAL_BM25_TOP_K=20
ODIRAG_RETRIEVAL_VECTOR_TOP_K=20
ODIRAG_RETRIEVAL_RRF_K=60
ODIRAG_RETRIEVAL_RERANK_TOP_K=8
ODIRAG_RETRIEVAL_FINAL_TOP_K=5
ODIRAG_RETRIEVAL_SCORE_THRESHOLD=0
ODIRAG_ALERT_WINDOW_HOURS=24
ODIRAG_ALERT_MINIMUM_SAMPLE_SIZE=5
ODIRAG_ALERT_CRAWL_FAILURE_RATE=0.2
ODIRAG_ALERT_INDEX_FAILURE_COUNT=1
ODIRAG_ALERT_CHAT_P95_MS=5000
ODIRAG_ALERT_EVALUATION_REGRESSION_COUNT=1
ODIRAG_ALERT_AVERAGE_COST=1.0

# Host bindings. Keep dependencies bound to loopback for local development.
BACKEND_PORT=8000
NGINX_PORT=8080
NGINX_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api

# Override image tags deliberately when upgrading and record the change in CHANGELOG.md.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.14.1
NGINX_IMAGE=nginx:1.30.4-alpine-slim
NODE_IMAGE=node:22-alpine
PYTHON_IMAGE=python:3.12-alpine3.24
