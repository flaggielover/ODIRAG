# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-alpine3.24

FROM ${PYTHON_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend /build/backend
RUN python -m pip install --upgrade pip \
    && python -m pip install /build/backend

FROM ${PYTHON_IMAGE} AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/home/odirag \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=builder /opt/venv /opt/venv
RUN site_packages="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && rm -rf \
        /opt/venv/bin/pip* \
        "${site_packages}/pip" \
        "${site_packages}"/pip-*.dist-info
WORKDIR /app/backend
COPY --chown=10001:10001 backend /app/backend
COPY --chown=10001:10001 config /app/config
COPY --chown=10001:10001 scripts /app/scripts
COPY --chown=10001:10001 deployment /app/deployment

RUN mkdir -p \
        /home/odirag \
        /app/data/attachments \
        /app/data/evaluation/runs \
        /app/data/experiments/runs \
        /app/data/indexes \
        /app/data/parsed \
        /app/data/raw \
        /app/data/reports \
    && chown -R 10001:10001 /home/odirag /app/data \
    && chmod 0755 \
        /app/deployment/container-entrypoint.sh \
        /app/deployment/initialize-demo.sh

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/system/health', timeout=3)" || exit 1
ENTRYPOINT ["/app/deployment/container-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
