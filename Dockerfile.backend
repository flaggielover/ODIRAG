# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-slim

FROM ${PYTHON_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend /build/backend
RUN python -m pip install --upgrade pip \
    && python -m pip install /build/backend

FROM ${PYTHON_IMAGE} AS runtime

ENV PATH="/opt/venv/bin:$PATH" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 odirag \
    && useradd --system --uid 10001 --gid 10001 --create-home odirag

COPY --from=builder /opt/venv /opt/venv
WORKDIR /app/backend
COPY --chown=odirag:odirag backend /app/backend
COPY --chown=odirag:odirag config /app/config
COPY --chown=odirag:odirag scripts /app/scripts
COPY --chown=odirag:odirag deployment /app/deployment

RUN mkdir -p \
        /app/data/attachments \
        /app/data/evaluation/runs \
        /app/data/experiments/runs \
        /app/data/indexes \
        /app/data/parsed \
        /app/data/raw \
        /app/data/reports \
    && chown -R odirag:odirag /app/data \
    && chmod 0755 \
        /app/deployment/container-entrypoint.sh \
        /app/deployment/initialize-demo.sh

USER odirag
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/system/health', timeout=3)" || exit 1
ENTRYPOINT ["/app/deployment/container-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
