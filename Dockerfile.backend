# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.12-alpine3.24@sha256:78098ea6a3a9c6a7727a5d4674e4a44e57e01fac878ee9cb4d24a86bd93916ff

FROM ${PYTHON_IMAGE} AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend/requirements.lock /build/backend/requirements.lock
RUN python -m pip install \
        --only-binary=:all: \
        --require-hashes \
        --requirement /build/backend/requirements.lock

COPY backend /build/backend
RUN python -m pip install \
        --no-build-isolation \
        --no-deps \
        /build/backend
RUN python -m pip check

FROM ${PYTHON_IMAGE} AS runtime

ARG ODIRAG_SOURCE_REVISION=unknown
ARG ODIRAG_RELEASE=development
ARG ODIRAG_BUILD_CREATED=unknown
ARG ODIRAG_SOURCE_URL=https://github.com/flaggielover/ODIRAG

LABEL org.opencontainers.image.source="${ODIRAG_SOURCE_URL}" \
      org.opencontainers.image.revision="${ODIRAG_SOURCE_REVISION}" \
      org.opencontainers.image.version="${ODIRAG_RELEASE}" \
      org.opencontainers.image.created="${ODIRAG_BUILD_CREATED}" \
      org.opencontainers.image.title="ODIRAG backend"

ENV PATH="/opt/venv/bin:$PATH" \
    HOME=/home/odirag \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=builder /opt/venv /opt/venv
RUN apk add --no-cache libstdc++=15.2.0-r5 \
    && site_packages="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && rm -rf \
        /opt/venv/bin/pip* \
        "${site_packages}/pip" \
        "${site_packages}"/pip-*.dist-info \
        /usr/local/bin/pip* \
        /usr/local/lib/python*/ensurepip \
        /usr/local/lib/python*/site-packages/pip \
        /usr/local/lib/python*/site-packages/pip-*.dist-info \
    && addgroup -S -g 10001 odirag \
    && adduser -S -D -H -u 10001 -G odirag odirag
WORKDIR /app/backend
COPY --chown=10001:10001 backend /app/backend
COPY --chown=10001:10001 config /app/config
COPY --chown=10001:10001 scripts /app/scripts
COPY --chown=10001:10001 deployment /app/deployment

RUN mkdir -p \
        /home/odirag \
        /app/data/attachments \
        /app/data/evaluation/runs \
        /app/data/experiments/runs \
        /app/data/indexes \
        /app/data/parsed \
        /app/data/raw \
        /app/data/reports \
    && chown -R 10001:10001 /home/odirag /app/data \
    && chmod 0755 \
        /app/deployment/container-entrypoint.sh \
        /app/deployment/initialize-demo.sh

USER odirag:odirag
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)" || exit 1
ENTRYPOINT ["/app/deployment/container-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
