MONITORING_COMPOSE_PROJECT_NAME=odirag-monitoring
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
GRAFANA_IMAGE=grafana/grafana:13.1.3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.33.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.5
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.20.1
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.89.0
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.28.0
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=odirag-admin
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
POSTGRES_EXPORTER_PASSWORD_FILE=/etc/odirag/monitoring/postgres_exporter_password
GRAFANA_ADMIN_PASSWORD_FILE=/etc/odirag/monitoring/grafana_admin_password
REDIS_EXPORTER_PASSWORD_FILE=/etc/odirag/monitoring/redis_exporter_password
