[Unit]
Description=Update ODIRAG production node_exporter textfile metrics
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector
Environment=ODIRAG_BACKUP_ROOT=/var/backups/odirag
StateDirectory=node_exporter/textfile_collector
StateDirectoryMode=0755
ExecStart=/opt/odirag/current/deploy/production/monitoring/scripts/update-textfile-metrics.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/backups/odirag /opt/odirag/current
ReadWritePaths=/var/lib/node_exporter/textfile_collector

[Install]
WantedBy=multi-user.target
