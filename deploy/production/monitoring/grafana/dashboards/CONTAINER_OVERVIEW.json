{
  "uid": "odirag-containers",
  "title": "CONTAINER_OVERVIEW",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"type":"timeseries","title":"Container CPU","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"odirag-prod-.*\"}[5m]))","legendFormat":"{{name}}"}]},
    {"type":"timeseries","title":"Container memory","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"sum by (name) (container_memory_working_set_bytes{name=~\"odirag-prod-.*\"})","legendFormat":"{{name}}"}]},
    {"type":"timeseries","title":"Network receive/transmit","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"sum by (name) (rate(container_network_receive_bytes_total{name=~\"odirag-prod-.*\"}[5m]))","legendFormat":"RX {{name}}"},{"expr":"sum by (name) (rate(container_network_transmit_bytes_total{name=~\"odirag-prod-.*\"}[5m]))","legendFormat":"TX {{name}}"}]},
    {"type":"timeseries","title":"Restarts","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"increase(odirag_container_restarts_total{stack=\"application\"}[1h])","legendFormat":"{{service}}"}]}
  ]
}
