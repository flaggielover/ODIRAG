# Copy to a root-owned 0600 file outside the repository before deployment.
# Do not place real credentials in this repository.
COMPOSE_PROJECT_NAME=odirag-prod
ODIRAG_RUNTIME_ENV_FILE=/etc/odirag/production.env
ODIRAG_RELEASE_ID=v0.1.0
ODIRAG_SOURCE_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_SHA
ODIRAG_BACKEND_IMAGE_REF=ghcr.io/flaggielover/odirag-backend@sha256:REPLACE_WITH_64_HEX_DIGEST
ODIRAG_FRONTEND_IMAGE_REF=ghcr.io/flaggielover/odirag-frontend@sha256:REPLACE_WITH_64_HEX_DIGEST
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_ARCHIVE_TIMEOUT=900s
REDIS_IMAGE=redis:7-alpine
QDRANT_IMAGE=qdrant/qdrant:v1.14.1
NGINX_IMAGE=nginx:1.30.4-alpine-slim
POSTGRES_DB=odirag
POSTGRES_USER=odirag
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
REDIS_PASSWORD=REPLACE_WITH_RANDOM_VALUE
QDRANT_API_KEY=
ODIRAG_ENVIRONMENT=production
ODIRAG_DEBUG=false
ODIRAG_LOG_JSON=true
ODIRAG_API_PREFIX=/api
ODIRAG_CORS_ORIGINS=["https://rag.suzheodirag.top"]
ODIRAG_DATABASE_URL=postgresql+asyncpg://odirag:REPLACE_WITH_RANDOM_VALUE@postgres:5432/odirag
ODIRAG_DATABASE_POOL_SIZE=5
ODIRAG_DATABASE_MAX_OVERFLOW=5
ODIRAG_REDIS_URL=redis://:REPLACE_WITH_RANDOM_VALUE@redis:6379/0
ODIRAG_CELERY_BROKER_URL=redis://:REPLACE_WITH_RANDOM_VALUE@redis:6379/1
ODIRAG_CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_RANDOM_VALUE@redis:6379/2
ODIRAG_QDRANT_URL=http://qdrant:6333
ODIRAG_QDRANT_COLLECTION=odirag_chunks
ODIRAG_HEALTH_CHECK_QDRANT=true
ODIRAG_RATE_LIMIT_BACKEND=redis
ODIRAG_RATE_LIMIT_ENABLED=true
ODIRAG_TRUSTED_PROXY_IPS=172.30.0.10
ODIRAG_JWT_SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARS
ODIRAG_ADMIN_USERNAME=admin
ODIRAG_ADMIN_PASSWORD=
ODIRAG_ADMIN_PASSWORD_HASH=
ODIRAG_BOOTSTRAP_ADMIN=false
ODIRAG_AUTO_CREATE_SCHEMA=false
ODIRAG_ALLOWED_ATTACHMENT_EXTENSIONS=[".docx",".htm",".html",".jpeg",".jpg",".pdf",".png",".txt",".webp",".xlsx",".zip"]
ODIRAG_EMBEDDING_PROVIDER=remote
ODIRAG_EMBEDDING_CACHE_PROVIDER=redis
ODIRAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
ODIRAG_EMBEDDING_API_KEY=REPLACE_WITH_PROVIDER_KEY
ODIRAG_EMBEDDING_MODEL=text-embedding-3-small
ODIRAG_EMBEDDING_DIMENSIONS=1536
ODIRAG_EMBEDDING_VERSION=v1
ODIRAG_VECTOR_STORE_PROVIDER=qdrant
ODIRAG_RERANK_PROVIDER=none
ODIRAG_RERANK_BASE_URL=https://api.cohere.com/v2
ODIRAG_RERANK_API_KEY=
ODIRAG_RERANK_MODEL=rerank-v3.5
ODIRAG_ANSWER_PROVIDER=extractive
ODIRAG_LLM_PROVIDER=direct
ODIRAG_DIRECT_LLM_BASE_URL=https://api.openai.com/v1
ODIRAG_DIRECT_LLM_API_KEY=
ODIRAG_DIRECT_LLM_MODEL=gpt-4.1-mini
ODIRAG_SOURCE_DISCOVERY_PROVIDER=disabled
ODIRAG_SOURCE_DISCOVERY_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
ODIRAG_SOURCE_DISCOVERY_API_KEY=
ODIRAG_SOURCE_DISCOVERY_OFFICIAL_SUFFIXES=[".gov.cn",".gov",".edu.cn"]
ODIRAG_SOURCE_DISCOVERY_AUTO_ENABLED=false
ODIRAG_SOURCE_DISCOVERY_AUTO_TOPICS=[]
ODIRAG_SOURCE_DISCOVERY_AUTO_INTERVAL_SECONDS=3600
ODIRAG_DEPENDENCY_TIMEOUT_SECONDS=3
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080
ODIRAG_NGINX_PROXY_IP=172.30.0.10
ODIRAG_EDGE_SUBNET=172.30.0.0/24
ODIRAG_PRIVATE_SUBNET=172.31.0.0/24
# Canonical unprefixed Coze names are intentionally listed separately.
COZE_ENABLED=false
COZE_API_TOKEN=
COZE_LEGACY_API_URL=
COZE_BATCH_API_URL=
COZE_DEFAULT_CONTRACT=batch_crawl
